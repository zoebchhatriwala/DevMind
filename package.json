{
  "name": "devmind",
  "version": "1.0.0",
  "description": "Pragmatic engineering standards and sanity checks for AI coding agents.",
  "type": "module",
  "main": "dist/bundles/manifest.json",
  "bin": {
    "devmind": "./bin/devmind.mjs"
  },
  "scripts": {
    "devmind": "node bin/devmind.mjs",
    "install": "node bin/devmind.mjs install --interactive",
    "verify": "node scripts/verify.mjs",
    "inspect": "node scripts/inspect.mjs",
    "contrast": "node scripts/contrast.mjs",
    "browser:audit": "node scripts/browser-audit.mjs",
    "quality": "node scripts/quality.mjs",
    "review": "node scripts/review.mjs",
    "eval": "node scripts/eval.mjs",
    "lint": "node scripts/verify.mjs",
    "strata": "node scripts/strata.mjs",
    "init": "node scripts/init.mjs",
    "handover": "node scripts/handover.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/test.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "bin",
    "scripts",
    "skills",
    "dist",
    "templates",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "antigravity",
    "ai-agent",
    "skills",
    "cursor",
    "windsurf",
    "claude-code",
    "copilot",
    "fullstack",
    "standards",
    "rag",
    "llm",
    "prompts"
  ],
  "author": "devmind contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoebchhatriwala/DevMind.git"
  },
  "homepage": "https://github.com/zoebchhatriwala/DevMind#readme",
  "bugs": {
    "url": "https://github.com/zoebchhatriwala/DevMind/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
